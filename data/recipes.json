            "note": "切絲"
          },
          {
            "name": "蒜頭",
            "amount": "1 瓣",
            "note": "切片，可去芽避免焦"
          },
          {
            "name": "生辣椒",
            "amount": "1/2 支",
            "note": "切圈"
          }
        ]
      },
      {
        "group": "醬汁",
        "items": [
          {
            "name": "水",
            "amount": "300 cc",
            "note": "依麵的烹煮時間增減"
          },
          {
            "name": "牛奶",
            "amount": "150 cc"
          },
          {
            "name": "鮮奶油",
            "amount": "50 cc",
            "note": "和牛奶的比例可依喜好調整"
          },
          {
            "name": "起司粉",
            "amount": "2 大匙"
          },
          {
            "name": "檸檬汁",
            "amount": "1 大匙＋依喜好",
            "note": "起鍋前加，上桌可再擠"
          }
        ]
      },
      {
        "group": "調味料",
        "items": [
          {
            "name": "沙拉油",
            "amount": "適量"
          },
          {
            "name": "鹽",
            "amount": "適量"
          },
          {
            "name": "黑胡椒",
            "amount": "適量"
          },
          {
            "name": "巴西里",
            "amount": "少許",
            "note": "選用，裝飾"
          }
        ]
      }
    ],
    "steps": [
      "蒜頭（1 瓣）切片、洋蔥（1/8 顆）切絲、生辣椒（1/2 支）切圈、鴻禧菇（50 g）剝散、培根（2 片）切小塊。",
      "平底鍋倒少許沙拉油，先放蒜片再開中火（冷油下蒜比較不會焦），讓每片都沾到油，炒到香味出來。",
      "加入洋蔥和辣椒，炒到洋蔥半透明。",
      "加入鴻禧菇炒到微金黃，再加培根炒到香味出來。",
      "倒入水（300 cc）、牛奶（150 cc）、鮮奶油（50 cc），撒點黑胡椒，煮到沸騰。",
      "直接放入乾的義大利麵（120 g），用夾子不時翻動，煮到喜歡的口感；醬汁太乾就隨時補一點水。",
      "加入起司粉（2 大匙），用鹽和黑胡椒做最後調味。",
      "關火後再加入檸檬汁（1 大匙，可依喜好再多）拌勻，盛盤，可撒少許巴西里、再擠些檸檬汁。"
    ],
    "tips": [
      "檸檬汁一定要關火後再加，醬汁沸騰時加酸容易結塊（油水分離）。",
      "一鍋煮的好處：省一鍋煮麵水、麵吸飽醬汁，麵的澱粉也讓醬汁自然變濃稠。",
      "沒有固定的煮麵時間，邊煮邊試吃，煮到喜歡的口感就好。",
      "影片推薦搭配白酒。"
    ],
