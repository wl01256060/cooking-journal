          },
          {
            "name": "米酒",
            "amount": "少許",
            "note": "燙海鮮用，可不放"
          },
          {
            "name": "冰塊水",
            "amount": "一盆",
            "note": "冰鎮用"
          },
          {
            "name": "萊姆或檸檬",
